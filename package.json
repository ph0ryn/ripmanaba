{
  "name": "ripmanaba",
  "version": "1.0.0",
  "description": "CLI for accessing the manaba learning management service.",
  "license": "MIT",
  "author": "ph0ryn",
  "repository": {
    "type": "git",
    "url": "https://github.com/ph0ryn/ripmanaba.git"
  },
  "bin": {
    "ripmanaba": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "module": "src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "check": "vp check",
    "fix": "vp check --fix",
    "format": "vp fmt",
    "lint": "vp lint",
    "precommit": "vp staged",
    "setup": "vp config --no-agent",
    "test": "bun test",
    "verify": "vp check && vp run test"
  },
  "dependencies": {
    "@steipete/sweet-cookie": "catalog:",
    "cheerio": "catalog:",
    "commander": "catalog:"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "^25.0.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.13"
  },
  "packageManager": "pnpm@11.1.1"
}
