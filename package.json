{
  "name": "ripmanaba",
  "version": "0.2.1",
  "description": "CLI for accessing the manaba learning management service.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ph0ryn/ripmanaba.git"
  },
  "license": "MIT",
  "author": "ph0ryn",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "ripmanaba": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun src/index.ts",
    "format": "oxfmt . && oxlint --fix --type-aware --type-check . && eslint --fix . && oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --type-check . && eslint .",
    "test": "bun test",
    "check": "pnpm run format:check && pnpm run lint && pnpm run test"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,mjs,cjs}": [
      "oxfmt",
      "oxlint --fix --type-aware --type-check",
      "eslint --fix",
      "oxfmt"
    ],
    "**/*.{json,jsonc,yml,yaml,md}": [
      "oxfmt"
    ]
  },
  "dependencies": {
    "@steipete/sweet-cookie": "catalog:",
    "cheerio": "catalog:",
    "commander": "catalog:"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "^25.0.0",
    "@typescript/native-preview": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-oxlint": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "sort-package-json": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "bun": ">=1.3.13"
  },
  "publishConfig": {
    "access": "public"
  }
}
